{
  "mcpServers": {
    "embrace-meetings": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://meeting-recorder-extension.vercel.app/api/mcp",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer YOUR_EMBRACE_API_KEY"
      }
    }
  }
}
